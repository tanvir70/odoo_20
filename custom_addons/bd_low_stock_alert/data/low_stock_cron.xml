<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_bd_low_stock_evaluation" model="ir.cron">
        <field name="name">Inventory: Periodic Low Stock Evaluation</field>
        <field name="model_id" ref="model_bd_stock_low_alert"/>
        <field name="state">code</field>
        <field name="code">model.run_stock_evaluation()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
