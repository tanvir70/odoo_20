<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Low Stock Alert List View -->
    <record id="view_bd_stock_low_alert_list" model="ir.ui.view">
        <field name="name">bd.stock.low.alert.list</field>
        <field name="model">bd.stock.low.alert</field>
        <field name="arch" type="xml">
            <list string="Low Stock Alerts" decoration-danger="severity in ('critical_low', 'out_of_stock')" decoration-warning="severity == 'low_stock'" decoration-muted="state == 'resolved'">
                <header>
                    <button name="action_check_now_button" string="Evaluate Low Stock Now" type="object" class="btn-primary"/>
                </header>
                <field name="name"/>
                <field name="product_id"/>
                <field name="warehouse_id"/>
                <field name="on_hand_qty"/>
                <field name="forecast_qty"/>
                <field name="min_qty"/>
                <field name="suggested_qty"/>
                <field name="uom_id"/>
                <field name="severity" widget="badge" decoration-danger="severity in ('critical_low', 'out_of_stock')" decoration-warning="severity == 'low_stock'"/>
                <field name="state" widget="badge" decoration-danger="state == 'active'" decoration-warning="state == 'acknowledged'" decoration-success="state == 'resolved'"/>
                <field name="detected_at"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Low Stock Alert Form View -->
    <record id="view_bd_stock_low_alert_form" model="ir.ui.view">
        <field name="name">bd.stock.low.alert.form</field>
        <field name="model">bd.stock.low.alert</field>
        <field name="arch" type="xml">
            <form string="Low Stock Alert">
                <header>
                    <button name="action_acknowledge" string="Acknowledge Alert" type="object" class="btn-primary" invisible="state != 'active'"/>
                    <button name="action_request_transfer" string="Request Stock Transfer" type="object" class="btn-success" invisible="state == 'resolved'"/>
                    <button name="action_resolve" string="Mark as Resolved" type="object" class="btn-secondary" invisible="state == 'resolved'"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,acknowledged,resolved"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="severity != 'out_of_stock'">
                        <strong>OUT OF STOCK! </strong> On-hand quantity has dropped to zero or below. Immediate replenishment is urgent.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="severity != 'critical_low'">
                        <strong>CRITICAL LOW STOCK! </strong> Stock level is below 50% of the safety threshold.
                    </div>

                    <div class="oe_title">
                        <span class="o_form_label">Stock Shortage Alert</span>
                        <h1>
                            <field name="name"/>
                        </h1>
                        <h2>
                            <field name="product_id" readonly="1"/>
                        </h2>
                    </div>

                    <group>
                        <group string="Location &amp; Warehouse">
                            <field name="warehouse_id" readonly="1"/>
                            <field name="location_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="uom_id"/>
                        </group>
                        <group string="Stock Snapshot &amp; Severity">
                            <field name="severity" widget="badge" decoration-danger="severity in ('critical_low', 'out_of_stock')" decoration-warning="severity == 'low_stock'"/>
                            <field name="on_hand_qty"/>
                            <field name="forecast_qty"/>
                            <field name="min_qty"/>
                            <field name="max_qty"/>
                            <field name="suggested_qty" class="fw-bold text-primary"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Audit &amp; Detection History" name="audit">
                            <group>
                                <group string="Timestamps">
                                    <field name="detected_at"/>
                                    <field name="last_checked_at"/>
                                    <field name="resolved_at"/>
                                </group>
                                <group string="Acknowledgement">
                                    <field name="acknowledged_by"/>
                                    <field name="acknowledged_at"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Low Stock Alert Search View -->
    <record id="view_bd_stock_low_alert_search" model="ir.ui.view">
        <field name="name">bd.stock.low.alert.search</field>
        <field name="model">bd.stock.low.alert</field>
        <field name="arch" type="xml">
            <search string="Search Low Stock Alerts">
                <field name="name"/>
                <field name="product_id"/>
                <field name="warehouse_id"/>
                <separator/>
                <filter name="active_unack" string="Active / Unacknowledged" domain="[('state', 'in', ('active', 'acknowledged'))]"/>
                <filter name="out_of_stock" string="Out of Stock" domain="[('severity', '=', 'out_of_stock')]"/>
                <filter name="critical_low" string="Critical Low" domain="[('severity', '=', 'critical_low')]"/>
                <filter name="resolved" string="Resolved History" domain="[('state', '=', 'resolved')]"/>
                <group>
                    <filter string="Warehouse" name="group_by_warehouse" context="{'group_by': 'warehouse_id'}"/>
                    <filter string="Product" name="group_by_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Severity" name="group_by_severity" context="{'group_by': 'severity'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Window for Low Stock Alerts -->
    <record id="action_bd_stock_low_alert" model="ir.actions.act_window">
        <field name="name">Low Stock Alerts</field>
        <field name="res_model">bd.stock.low.alert</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active_unack': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No active low stock alerts!
            </p>
            <p>
                The automated inventory monitor continuously checks on-hand quantities against minimum thresholds and triggers alerts when stock runs low.
            </p>
        </field>
    </record>

    <!-- Server Action to Evaluate Stock from Cog / Action Menu -->
    <record id="action_server_evaluate_low_stock" model="ir.actions.server">
        <field name="name">Evaluate Stock Levels Now</field>
        <field name="model_id" ref="model_bd_stock_low_alert"/>
        <field name="binding_model_id" ref="model_bd_stock_low_alert"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
action = model.action_check_now_button()
        </field>
    </record>

</odoo>
