<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_inherit_bd_alert" model="ir.ui.view">
        <field name="name">product.template.form.inherit.bd.alert</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_low_stock_alerts" type="object"
                        class="oe_stat_button" icon="fa-exclamation-triangle"
                        invisible="low_stock_alert_count == 0">
                    <field name="low_stock_alert_count" widget="statinfo" string="Low Stock"/>
                </button>
            </xpath>
            <xpath expr="//group[@name='group_general']" position="inside">
                <field name="low_stock_threshold" invisible="not is_storable"/>
                <field name="low_stock_target" invisible="not is_storable"/>
            </xpath>
        </field>
    </record>
</odoo>
