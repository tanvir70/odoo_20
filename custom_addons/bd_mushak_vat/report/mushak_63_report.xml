<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action Report for Mushak 6.3 Tax Invoice -->
    <record id="action_report_mushak_63" model="ir.actions.report">
        <field name="name">Mushak 6.3 Tax Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bd_mushak_vat.report_mushak_63_document</field>
        <field name="report_file">bd_mushak_vat.report_mushak_63_document</field>
        <field name="print_report_name">'Mushak-6.3-%s' % (object.mushak_number or object.name)</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_mushak_a4"/>
    </record>

    <!-- QWeb Template -->
    <template id="report_mushak_63_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="article mushak_page" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id">
                    <link rel="stylesheet" href="/bd_mushak_vat/static/src/css/mushak_report.css"/>

                    <!-- Watermark if draft -->
                    <div t-if="o.state != 'posted'" style="position: absolute; opacity: 0.15; transform: rotate(-35deg); font-size: 70px; font-weight: bold; top: 350px; left: 120px; z-index: 999; color: red;">
                        DRAFT – NOT A TAX INVOICE
                    </div>

                    <!-- Header Block -->
                    <div class="position-relative mushak_header">
                        <div class="mushak_form_badge">
                            মূসক-৬.৩<br/>
                            <span style="font-size: 9px; font-weight: normal;">[বিধি ৪০ এর উপ-বিধি (১) এর দফা (গ) ও (চ)]</span>
                        </div>
                        <h4>গণপ্রজাতন্ত্রী বাংলাদেশ সরকার</h4>
                        <h5>জাতীয় রাজস্ব বোর্ড</h5>
                        <h6>কর চালানপত্র / TAX INVOICE</h6>
                    </div>

                    <!-- Supplier & Buyer Information Boxes -->
                    <table class="mushak_box_table">
                        <tr>
                            <td style="width: 50%;">
                                <strong>নিবন্ধিত ব্যক্তির নাম (Supplier Name):</strong> <span t-esc="o.company_id.name"/><br/>
                                <strong>নিবন্ধিত ব্যক্তির বিআইএন (Supplier BIN):</strong> <span t-esc="o.company_id.mushak_bin or 'N/A'"/><br/>
                                <strong>চালানপত্র জারির ঠিকানা (Address):</strong>
                                <span t-esc="o.company_id.partner_id._display_address()"/>
                            </td>
                            <td style="width: 50%;">
                                <strong>চালানপত্র নম্বর (Challan No):</strong>
                                <strong style="font-size: 13px;"><span t-esc="o.mushak_number or 'UNASSIGNED (DRAFT)'"/></strong><br/>
                                <strong>ইস্যুর তারিখ (Issue Date):</strong>
                                <span t-esc="o.invoice_date or ''"/><br/>
                                <strong>ইস্যুর সময় (Issue Time):</strong>
                                <span t-esc="o.mushak_issue_datetime or ''"/><br/>
                                <strong>অর্থবছর (Fiscal Year):</strong>
                                <span t-esc="o.mushak_fiscal_year_label or ''"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="width: 50%; border-top: 1px dotted #ccc; padding-top: 4px;">
                                <strong>ক্রেতার নাম (Buyer Name):</strong> <span t-esc="o.partner_id.name"/><br/>
                                <strong>ক্রেতার বিআইএন (Buyer BIN):</strong> <span t-esc="o.partner_id.mushak_bin or 'অনিবন্ধিত / N/A'"/><br/>
                                <strong>ক্রেতার ঠিকানা (Buyer Address):</strong>
                                <span t-esc="o.partner_id._display_address()"/>
                            </td>
                            <td style="width: 50%; border-top: 1px dotted #ccc; padding-top: 4px;">
                                <strong>গন্তব্যস্থল (Final Destination):</strong>
                                <span t-esc="o.mushak_delivery_address or o.partner_id._display_address()"/><br/>
                                <strong>যানবাহনের প্রকৃতি ও নম্বর (Vehicle Info):</strong>
                                <span t-esc="o.mushak_vehicle_type or ''"/> <span t-if="o.mushak_vehicle_number" t-esc="'(' + o.mushak_vehicle_number + ')'"/>
                            </td>
                        </tr>
                    </table>

                    <!-- Line Items Table (Statutory 11 Columns) -->
                    <table class="mushak_lines_table">
                        <thead>
                            <tr>
                                <th style="width: 4%;">১<br/>ক্রমিক</th>
                                <th style="width: 24%;">২<br/>পণ্য বা সেবার বর্ণনা (ব্র্যান্ডসহ)</th>
                                <th style="width: 7%;">৩<br/>একক</th>
                                <th style="width: 6%;">৪<br/>পরিমাণ</th>
                                <th style="width: 9%;">৫<br/>একক মূল্য (টাকা)</th>
                                <th style="width: 10%;">৬<br/>মোট মূল্য (টাকা)</th>
                                <th style="width: 6%;">৭<br/>সম্পূরক শুল্কের হার</th>
                                <th style="width: 8%;">৮<br/>সম্পূরক শুল্ক (টাকা)</th>
                                <th style="width: 6%;">৯<br/>মূসক হার</th>
                                <th style="width: 9%;">১০<br/>মূসকের পরিমাণ (টাকা)</th>
                                <th style="width: 11%;">১১<br/>সর্বমোট মূল্য (টাকা)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="sl" t-value="1"/>
                            <t t-set="total_val" t-value="0.0"/>
                            <t t-set="total_sd" t-value="0.0"/>
                            <t t-set="total_vat" t-value="0.0"/>
                            <t t-set="total_grand" t-value="0.0"/>

                            <t t-foreach="o.invoice_line_ids.filtered(lambda l: l.display_type in (False, 'product'))" t-as="line">
                                <tr>
                                    <td class="text-center"><span t-esc="o.format_mushak_num(sl)"/></td>
                                    <td>
                                        <span t-esc="line.name"/>
                                        <div t-if="line.product_id.mushak_hs_code" class="text-muted" style="font-size: 8px;">
                                            HS: <span t-esc="line.product_id.mushak_hs_code"/>
                                        </div>
                                    </td>
                                    <td class="text-center"><span t-esc="line.product_uom_id.name or ''"/></td>
                                    <td class="text-end"><span t-esc="o.format_mushak_num(line.quantity)"/></td>
                                    <td class="text-end"><span t-esc="o.format_mushak_num(line.price_unit)"/></td>
                                    <td class="text-end"><span t-esc="o.format_mushak_num(line.mushak_value_excl_tax)"/></td>
                                    <td class="text-center"><span t-esc="o.format_mushak_num(line.mushak_sd_rate)"/>%</td>
                                    <td class="text-end"><span t-esc="o.format_mushak_num(line.mushak_sd_amount)"/></td>
                                    <td class="text-center"><span t-esc="o.format_mushak_num(line.mushak_vat_rate)"/>%</td>
                                    <td class="text-end"><span t-esc="o.format_mushak_num(line.mushak_vat_amount)"/></td>
                                    <td class="text-end"><strong><span t-esc="o.format_mushak_num(line.mushak_value_incl_tax)"/></strong></td>
                                </tr>
                                <t t-set="sl" t-value="sl + 1"/>
                                <t t-set="total_val" t-value="total_val + line.mushak_value_excl_tax"/>
                                <t t-set="total_sd" t-value="total_sd + line.mushak_sd_amount"/>
                                <t t-set="total_vat" t-value="total_vat + line.mushak_vat_amount"/>
                                <t t-set="total_grand" t-value="total_grand + line.mushak_value_incl_tax"/>
                            </t>

                            <!-- Totals Row -->
                            <tr style="font-weight: bold; background-color: #f9f9f9;">
                                <td colspan="5" class="text-end">সর্বমোট (Total):</td>
                                <td class="text-end"><span t-esc="o.format_mushak_num(total_val)"/></td>
                                <td></td>
                                <td class="text-end"><span t-esc="o.format_mushak_num(total_sd)"/></td>
                                <td></td>
                                <td class="text-end"><span t-esc="o.format_mushak_num(total_vat)"/></td>
                                <td class="text-end"><span t-esc="o.format_mushak_num(total_grand)"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Amount in Words -->
                    <div style="margin-top: 6px; padding: 4px; background-color: #fafafa; border: 1px solid #ddd;">
                        <div><strong>কথায় (বাংলা):</strong> <span t-esc="o.get_mushak_amount_words_bn(total_grand)"/></div>
                        <div><strong>In Words (English):</strong> <span t-esc="o.get_mushak_amount_words_en(total_grand)"/></div>
                        <div t-if="o.currency_id != o.company_id.currency_id" class="text-muted" style="font-size: 9px; margin-top: 2px;">
                            * Foreign currency document: Converted at applicable exchange rate to BDT. Invoice Total: <span t-esc="o.currency_id.symbol"/> <span t-esc="o.amount_total"/>.
                        </div>
                    </div>

                    <!-- Footer Declaration & Signatory Box -->
                    <div class="row mushak_declaration mt-4">
                        <div class="col-7">
                            <div style="font-size: 10px;">
                                <em>প্রতিষ্ঠান কর্তৃপক্ষের দায়িত্বপ্রাপ্ত ব্যক্তির নাম:</em> <strong><span t-esc="o.mushak_signatory_id.name or o.create_uid.name"/></strong><br/>
                                <em>পদবি:</em> <span t-esc="o.mushak_signatory_id.partner_id.function or 'Authorized Signatory'"/><br/>
                                <em>স্বাক্ষর:</em> ___________________________<br/>
                                <em>সীল:</em>
                            </div>
                            <div style="margin-top: 8px; font-size: 9px; color: #555;">
                                * কর চালানপত্রটি বিধি মোতাবেক ইলেকট্রনিক মাধ্যমে সংরক্ষিত ও প্রস্তুতকৃত।
                            </div>
                        </div>
                        <div class="col-5 text-end mushak_qr_box">
                            <div t-if="o.mushak_access_token">
                                <img t-att-src="'/report/barcode/?barcode_type=QR&amp;value=%s&amp;width=100&amp;height=100' % (o.get_mushak_verification_url())"
                                     style="width: 80px; height: 80px; border: 1px solid #ccc; padding: 2px;"/>
                                <div style="font-size: 8px; color: #555; margin-top: 2px;">
                                    Verify Authenticity<br/>
                                    <span t-esc="o.mushak_number"/>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </t>
        </t>
    </template>
</odoo>
