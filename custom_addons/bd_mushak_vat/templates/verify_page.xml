<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="verify_page" name="Mushak Document Verification Portal">
        &lt;!DOCTYPE html&gt;
        <html lang="en">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex, nofollow"/>
                <title>Bangladesh NBR Mushak Verification</title>
                <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"/>
                <style>
                    body {
                        background-color: #f4f6f9;
                        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
                    }
                    .verify-card {
                        max-width: 620px;
                        margin: 40px auto;
                        border-radius: 12px;
                        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
                        background: #ffffff;
                        overflow: hidden;
                    }
                    .verify-header {
                        background: linear-gradient(135deg, #0d6efd, #0b5ed7);
                        color: #ffffff;
                        padding: 24px;
                        text-align: center;
                    }
                    .verify-header.invalid {
                        background: linear-gradient(135deg, #dc3545, #b02a37);
                    }
                    .verify-body {
                        padding: 24px;
                    }
                    .field-label {
                        font-weight: 600;
                        color: #6c757d;
                        font-size: 0.88rem;
                    }
                    .field-val {
                        font-weight: 600;
                        color: #212529;
                        font-size: 0.95rem;
                    }
                    .highlight-val {
                        font-size: 1.25rem;
                        font-weight: 700;
                        color: #0d6efd;
                    }
                </style>
            </head>
            <body>
                <div class="container">
                    <div class="verify-card">
                        <t t-if="data and data.get('found')">
                            <div t-att-class="'verify-header ' + ('invalid' if not data.get('is_valid') else '')">
                                <h4 class="mb-1">
                                    <t t-if="data.get('is_valid')">✓ Statutory Document Verified</t>
                                    <t t-else="">⚠ Document Record: Cancelled</t>
                                </h4>
                                <p class="mb-0 small opacity-75">National Board of Revenue, Government of Bangladesh</p>
                            </div>

                            <div class="verify-body">
                                <div class="alert alert-light border text-center mb-4">
                                    <span class="badge bg-primary fs-6 mb-1"><t t-out="data.get('document_type')"/></span>
                                    <h3 class="mb-0 mt-1 fw-bold text-dark"><t t-out="data.get('document_number')"/></h3>
                                    <div class="text-muted small mt-1">Issued: <t t-out="data.get('issue_datetime')"/></div>
                                </div>

                                <div class="row g-3 mb-4">
                                    <div class="col-sm-6">
                                        <div class="field-label">Supplier / Issuer</div>
                                        <div class="field-val"><t t-out="data.get('supplier_name')"/></div>
                                        <div class="small text-muted">BIN: <t t-out="data.get('supplier_bin')"/></div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="field-label">Buyer / Recipient</div>
                                        <div class="field-val"><t t-out="data.get('buyer_name_masked')"/></div>
                                        <div class="small text-muted">BIN: <t t-out="data.get('buyer_bin')"/></div>
                                    </div>
                                </div>

                                <hr/>

                                <div class="row g-2 mb-3">
                                    <div class="col-6 text-muted">Value Excl. Tax:</div>
                                    <div class="col-6 text-end fw-semibold">Tk <t t-out="'{:,.2f}'.format(data.get('total_value', 0.0))"/></div>

                                    <div class="col-6 text-muted">Supplementary Duty:</div>
                                    <div class="col-6 text-end fw-semibold">Tk <t t-out="'{:,.2f}'.format(data.get('total_sd', 0.0))"/></div>

                                    <div class="col-6 text-muted">Value Added Tax (VAT):</div>
                                    <div class="col-6 text-end fw-semibold">Tk <t t-out="'{:,.2f}'.format(data.get('total_vat', 0.0))"/></div>

                                    <div class="col-6 fs-5 fw-bold text-dark pt-2 border-top">Grand Total:</div>
                                    <div class="col-6 fs-5 fw-bold text-primary text-end pt-2 border-top">
                                        Tk <t t-out="'{:,.2f}'.format(data.get('grand_total', 0.0))"/>
                                    </div>
                                </div>

                                <div class="text-center mt-4">
                                    <span t-if="data.get('is_valid')" class="badge bg-success-subtle text-success border border-success px-3 py-2 fs-6">
                                        ✓ Official Document Active in System
                                    </span>
                                    <span t-else="" class="badge bg-danger-subtle text-danger border border-danger px-3 py-2 fs-6">
                                        ⚠ Document Has Been Cancelled
                                    </span>
                                </div>
                            </div>
                        </t>

                        <t t-else="">
                            <div class="verify-header invalid">
                                <h4 class="mb-1">✕ Document Verification Failed</h4>
                                <p class="mb-0 small opacity-75">National Board of Revenue, Government of Bangladesh</p>
                            </div>
                            <div class="verify-body text-center py-5">
                                <div class="display-6 text-danger mb-3">404</div>
                                <h5 class="fw-bold mb-2">No Statutory Document Found</h5>
                                <p class="text-muted mb-0">
                                    The provided QR verification token is either invalid, altered, or references an unposted draft document.
                                    Please verify the original printed document.
                                </p>
                            </div>
                        </t>

                        <div class="card-footer text-center text-muted small py-3 bg-light border-top">
                            Secured Statutory Verification Service · VAT &amp; Supplementary Duty Act 2012
                        </div>
                    </div>
                </div>
            </body>
        </html>
    </template>
</odoo>
