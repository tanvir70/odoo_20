<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bd_stock_transfer_reject_wizard_form" model="ir.ui.view">
        <field name="name">bd.stock.transfer.reject.wizard.form</field>
        <field name="model">bd.stock.transfer.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Stock Transfer">
                <p class="text-muted">
                    Please provide a clear reason for rejecting this transfer requisition. This reason will be logged in the audit trail and visible to the requester.
                </p>
                <group>
                    <field name="request_id" invisible="1"/>
                    <field name="rejection_reason" required="1" placeholder="e.g. Insufficient central warehouse reserve, alternative branch resupply in progress..."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Reject Request" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
