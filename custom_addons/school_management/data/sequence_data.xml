<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_school_student" model="ir.sequence">
        <field name="name">Student Registration Sequence</field>
        <field name="code">school.student</field>
        <field name="prefix">STD/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="seq_school_fee" model="ir.sequence">
        <field name="name">Fee Invoice Sequence</field>
        <field name="code">school.fee</field>
        <field name="prefix">FEE/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>
</odoo>
