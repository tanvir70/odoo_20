<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Student ID Card Report Action -->
    <record id="action_report_student_card" model="ir.actions.report">
        <field name="name">Student ID Card</field>
        <field name="model">school.student</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">school_management.report_student_card_template</field>
        <field name="binding_model_id" ref="model_school_student"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Student ID Card QWeb Template -->
    <template id="report_student_card_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="student">
                <t t-call="web.basic_layout">
                    <div class="page" style="page-break-after: always; padding: 30px;">
                        <div style="border: 2px solid #0056b3; border-radius: 12px; padding: 20px; max-width: 480px; margin: auto; font-family: sans-serif; background-color: #ffffff; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
                            <!-- Card Header -->
                            <div style="background-color: #0056b3; color: white; padding: 14px; border-radius: 8px 8px 0 0; text-align: center; margin: -20px -20px 20px -20px;">
                                <h3 style="margin: 0; font-size: 18px; text-transform: uppercase; letter-spacing: 1px;">Academy High School</h3>
                                <p style="margin: 3px 0 0 0; font-size: 11px; opacity: 0.9;">Official Student Identity Card</p>
                            </div>

                            <!-- Card Body -->
                            <div style="display: flex;">
                                <div style="flex: 0 0 120px; text-align: center; padding-right: 15px;">
                                    <t t-if="student.image_1920">
                                        <img t-att-src="image_data_uri(student.image_1920)" style="width: 100px; height: 120px; object-fit: cover; border-radius: 8px; border: 1px solid #ddd;"/>
                                    </t>
                                    <t t-else="">
                                        <div style="width: 100px; height: 120px; background-color: #f1f3f5; border-radius: 8px; border: 1px solid #ddd; line-height: 120px; font-size: 11px; color: #868e96;">
                                            No Photo
                                        </div>
                                    </t>
                                    <div style="margin-top: 8px; font-weight: bold; color: #0056b3; font-size: 13px;">
                                        <t t-esc="student.student_id"/>
                                    </div>
                                </div>
                                <div style="flex: 1; font-size: 13px; line-height: 1.6;">
                                    <h4 style="margin: 0 0 8px 0; color: #212529; font-size: 17px;"><t t-esc="student.name"/></h4>
                                    <table style="width: 100%;">
                                        <tr>
                                            <td style="color: #6c757d; width: 42%;">Class / Grade:</td>
                                            <td><strong><t t-esc="student.classroom_id.name or 'N/A'"/></strong></td>
                                        </tr>
                                        <tr>
                                            <td style="color: #6c757d;">Blood Group:</td>
                                            <td><strong><t t-esc="student.blood_group or 'N/A'"/></strong></td>
                                        </tr>
                                        <tr>
                                            <td style="color: #6c757d;">Age / DOB:</td>
                                            <td><t t-esc="student.age"/> yrs (<t t-esc="student.date_of_birth or 'N/A'"/>)</td>
                                        </tr>
                                        <tr>
                                            <td style="color: #6c757d;">Guardian:</td>
                                            <td><t t-esc="student.guardian_name or 'N/A'"/></td>
                                        </tr>
                                        <tr>
                                            <td style="color: #6c757d;">Emergency Tel:</td>
                                            <td><t t-esc="student.guardian_phone or 'N/A'"/></td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <!-- Card Footer -->
                            <div style="border-top: 1px dashed #ced4da; margin-top: 15px; padding-top: 8px; font-size: 10px; color: #868e96; text-align: center;">
                                Property of Academy High School. If found, please return to Admin Office.
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
