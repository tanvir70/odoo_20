<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Attendance List View (Inline Editable) -->
    <record id="view_school_attendance_list" model="ir.ui.view">
        <field name="name">school.attendance.list</field>
        <field name="model">school.attendance</field>
        <field name="arch" type="xml">
            <list string="Daily Attendance" editable="top" decoration-success="status == 'present'" decoration-danger="status == 'absent'" decoration-warning="status == 'late'" decoration-info="status == 'excused'">
                <field name="date"/>
                <field name="classroom_id"/>
                <field name="student_id"/>
                <field name="status" widget="badge" decoration-success="status == 'present'" decoration-danger="status == 'absent'" decoration-warning="status == 'late'" decoration-info="status == 'excused'"/>
                <field name="remarks" placeholder="Optional notes..."/>
            </list>
        </field>
    </record>

    <!-- Attendance Search View -->
    <record id="view_school_attendance_search" model="ir.ui.view">
        <field name="name">school.attendance.search</field>
        <field name="model">school.attendance</field>
        <field name="arch" type="xml">
            <search string="Search Attendance">
                <field name="student_id"/>
                <field name="classroom_id"/>
                <field name="date"/>
                <separator/>
                <filter string="Today" name="filter_today" domain="[('date', '=', context_today())]"/>
                <separator/>
                <filter string="Present" name="filter_present" domain="[('status', '=', 'present')]"/>
                <filter string="Absent" name="filter_absent" domain="[('status', '=', 'absent')]"/>
                <filter string="Late" name="filter_late" domain="[('status', '=', 'late')]"/>
                <filter string="Excused" name="filter_excused" domain="[('status', '=', 'excused')]"/>
                <group>
                    <filter string="Classroom" name="group_classroom" context="{'group_by': 'classroom_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Attendance Window Action -->
    <record id="action_school_attendance" model="ir.actions.act_window">
        <field name="name">Attendance</field>
        <field name="res_model">school.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_school_attendance_search"/>
        <field name="context">{'search_default_filter_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record student attendance
            </p>
            <p>
                Track student attendance daily or per session by class.
            </p>
        </field>
    </record>

</odoo>
