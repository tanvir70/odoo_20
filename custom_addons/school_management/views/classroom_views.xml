<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Classroom List View -->
    <record id="view_school_classroom_list" model="ir.ui.view">
        <field name="name">school.classroom.list</field>
        <field name="model">school.classroom</field>
        <field name="arch" type="xml">
            <list string="Classrooms">
                <field name="name"/>
                <field name="code"/>
                <field name="teacher_id"/>
                <field name="capacity"/>
                <field name="student_count"/>
            </list>
        </field>
    </record>

    <!-- Classroom Form View -->
    <record id="view_school_classroom_form" model="ir.ui.view">
        <field name="name">school.classroom.form</field>
        <field name="model">school.classroom</field>
        <field name="arch" type="xml">
            <form string="Classroom">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_students" type="object" class="oe_stat_button" icon="fa-graduation-cap">
                            <field name="student_count" widget="statinfo" string="Students"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Classroom / Grade"/>
                        <h1>
                            <field name="name" placeholder="e.g. Grade 10 - Section A"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Class Details">
                            <field name="code"/>
                            <field name="teacher_id"/>
                        </group>
                        <group string="Capacity">
                            <field name="capacity"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Students" name="students">
                            <field name="student_ids">
                                <list>
                                    <field name="student_id"/>
                                    <field name="name"/>
                                    <field name="gender"/>
                                    <field name="guardian_name"/>
                                    <field name="guardian_phone"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Courses" name="courses">
                            <field name="course_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="teacher_id"/>
                                    <field name="credits"/>
                                </list>
                            </field>
                        </page>
                        <page string="Room Notes" name="notes">
                            <field name="notes" placeholder="Building, room number, or special class notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Classroom Search View -->
    <record id="view_school_classroom_search" model="ir.ui.view">
        <field name="name">school.classroom.search</field>
        <field name="model">school.classroom</field>
        <field name="arch" type="xml">
            <search string="Search Classrooms">
                <field name="name"/>
                <field name="code"/>
                <field name="teacher_id"/>
                <group>
                    <filter string="Class Teacher" name="group_teacher" context="{'group_by': 'teacher_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Classroom Window Action -->
    <record id="action_school_classroom" model="ir.actions.act_window">
        <field name="name">Classrooms</field>
        <field name="res_model">school.classroom</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_school_classroom_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new classroom or grade
            </p>
            <p>
                Define sections, assign class teachers, and monitor capacity.
            </p>
        </field>
    </record>

</odoo>
